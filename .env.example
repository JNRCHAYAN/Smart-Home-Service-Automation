# Server
PORT=5001
NODE_ENV=development

# MongoDB connection string (required — the server refuses to start without it).
# Copy this file to server/.env and set MONGODB_URI to your cluster URI, e.g.:
#   mongodb+srv://user:pass@cluster.mongodb.net/smart-home-service
MONGODB_URI=

# Seeded demo accounts
DEMO_CUSTOMER_PHONE=01700000000
DEMO_CUSTOMER_PASSWORD=pass1234
DEMO_PROVIDER_PHONE=01800000001
DEMO_PROVIDER_PASSWORD=pass1234

# JWT secret (mock auth)
JWT_SECRET=change-me-in-production-super-secret

# Client
VITE_API_URL=http://localhost:5000/api

# DeepSeek — powers the Servio AI chatbot (chat + tool calling).
# Get an API key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Gemini (Google AI Studio) — used ONLY for RAG embeddings (DeepSeek has no embeddings API).
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ChromaDB for RAG (local) - Run: docker run -p 8000:8000 chromadb/chroma
CHROMA_URL=http://localhost:8000

# Redis for conversation memory (optional - Upstash free tier at upstash.com)
REDIS_URL=
